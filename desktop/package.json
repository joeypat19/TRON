{
  "name": "tron",
  "version": "0.1.6",
  "description": "The TRON desktop app and local search experience.",
  "author": "TRONXVI",
  "homepage": "https://tronxvi.com",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build-info": "node scripts/write-build-info.cjs",
    "verify": "node --check main.cjs && node --check preload.cjs && node --check renderer/renderer.js",
    "dist": "npm run build-info && electron-builder --win nsis",
    "dist:dir": "npm run build-info && electron-builder --win dir",
    "release:check": "node scripts/validate-release.cjs",
    "release:artifacts": "node scripts/validate-release-artifacts.cjs",
    "release": "npm run build-info && npm run release:check && electron-builder --win nsis --publish always && npm run release:artifacts"
  },
  "build": {
    "appId": "com.tronxvi.browser",
    "productName": "TRON",
    "artifactName": "TRON-${version}-Setup.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "build-info.json",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "joeypat19",
      "repo": "TRON",
      "releaseType": "release"
    },
    "win": {
      "icon": "assets/tron-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
